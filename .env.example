# ================================================================
# Maatlaadi Bill - Environment Configuration
# ================================================================

# Server Port (Default: 3000)
PORT=3000

# Google Gemini API Key (Server-side ONLY, never exposed to frontend)
# Get a key from: https://aistudio.google.com/
# Leave empty to run in 100% full Demo Mode with pre-configured AI responses
GEMINI_API_KEY=your_gemini_api_key_here

# Auth Mode: mock (instant login with local business profile)
AUTH_MODE=mock
